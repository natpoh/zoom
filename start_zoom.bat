@echo off
echo ==========================================
echo       Zoom Automation Launcher
echo ==========================================
echo.

:: Переходим в папку, где лежит этот .bat файл
cd /d "%~dp0"

:: Проверяем, существует ли виртуальное окружение
if not exist "venv\Scripts\python.exe" (
    echo [ERROR] Виртуальное окружение не найдено!
    echo Сначала запустите файл setup.ps1, чтобы установить Python и нужные библиотеки.
    echo.
    pause
    exit /b 1
)

:: Запускаем сам скрипт через Python внутри виртуального окружения
"venv\Scripts\python.exe" zoom.py

:: Эта часть кода сработает, когда скрипт завершит работу (или вылетит с ошибкой)
echo.
echo ==========================================
echo Скрипт завершил работу или произошла ошибка.
pause
